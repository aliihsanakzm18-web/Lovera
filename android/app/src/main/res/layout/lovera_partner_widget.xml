<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 0. Dinamik Tema Arka Plan Deseni (Koyu / Açık / Vektör) -->
    <ImageView
        android:id="@+id/widget_bg_pattern"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background" />

    <!-- 1. Arka Plan Özel Fotoğraf Katmanı -->
    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- 2. Kenarlardan Ortaya Doğru Karanlıktan Açığa Radyal Vignette Efekti -->
    <ImageView
        android:id="@+id/widget_bg_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_vignette_overlay"
        android:visibility="gone" />

    <!-- 3. İçerik Katmanı -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Üst Satır: Partner Çipi (Sol), Gün Sayacı (Orta), Son Aktif (Sağ) -->
        <!-- Üst Satır: Partner Çipi (Sol), Gün Sayacı (Orta), Son Aktif (Sağ) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Partner Adı & Kalp Çipi (Sola yaslı, esnek) -->
            <LinearLayout
                android:id="@+id/widget_partner_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_chip_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="5dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💜"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/widget_partner_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="Lovera"
                    android:textColor="#F3F4F6"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Gün Sayacı (Ortada) -->
            <LinearLayout
                android:id="@+id/widget_counter_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_counter_bg"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="9dp"
                android:paddingVertical="5dp">

                <TextView
                    android:id="@+id/widget_days_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="0"
                    android:textColor="#A78BFA"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_counter_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:includeFontPadding="false"
                    android:text="gün"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Son Aktif / Canlı Rozet Çipi (Sağa yaslı) -->
            <TextView
                android:id="@+id/widget_last_seen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_chip_bg"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingHorizontal="9dp"
                android:paddingVertical="5dp"
                android:singleLine="true"
                android:text="Şimdi aktif"
                android:textColor="#34D399"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Orta Kısım: Fotoğrafın (yüzlerin) açıkça görünmesi için serbest alan ve Mesaj Bildirimi Yığını -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="bottom|center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="6dp">

            <!-- Mesaj Bildirim Baloncuğu Yığını -->
            <LinearLayout
                android:id="@+id/widget_message_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- 1. En eski görünen mesaj (arka katman efekti için daha küçük / soluk) -->
                <LinearLayout
                    android:id="@+id/widget_msg_bubble_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="-4dp"
                    android:background="@drawable/widget_message_bubble_bg"
                    android:gravity="center_vertical"
                    android:maxWidth="220dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/widget_msg_text_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text=""
                        android:textColor="#B3DDD6FE"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- 2. İkinci mesaj (orta katman) -->
                <LinearLayout
                    android:id="@+id/widget_msg_bubble_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="-4dp"
                    android:background="@drawable/widget_message_bubble_bg"
                    android:gravity="center_vertical"
                    android:maxWidth="230dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="11dp"
                    android:paddingVertical="4dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/widget_msg_text_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text=""
                        android:textColor="#E2E8F0"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <!-- 3. En yeni gelen mesaj (ön katman, parlak ve belirgin) -->
                <LinearLayout
                    android:id="@+id/widget_msg_bubble_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_message_bubble_bg"
                    android:gravity="center_vertical"
                    android:maxWidth="240dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:text="💬"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/widget_msg_text_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text=""
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <!-- Eğer 3'ten fazla mesaj varsa (+2 gibi) rozet -->
                    <TextView
                        android:id="@+id/widget_msg_badge_more"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/widget_chip_bg"
                        android:paddingHorizontal="5dp"
                        android:paddingVertical="1dp"
                        android:text="+2"
                        android:textColor="#F472B6"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Alt Satır: Batarya & Durum (Evde / Dışarıda / Yürüyor) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Batarya Chip -->
            <LinearLayout
                android:id="@+id/widget_battery_chip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/widget_chip_bg"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="7dp">

                <ImageView
                    android:id="@+id/widget_battery_icon"
                    android:layout_width="14dp"
                    android:layout_height="22dp"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/widget_battery_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:ellipsize="none"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="%100"
                    android:textColor="#34D399"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Konum / Durum Chip (Evde, Dışarıda, Yürüyor) -->
            <LinearLayout
                android:id="@+id/widget_status_chip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1.2"
                android:background="@drawable/widget_chip_bg"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="7dp">

                <TextView
                    android:id="@+id/widget_status_emoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/widget_status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="Dışarıda"
                    android:textColor="#F3F4F6"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
