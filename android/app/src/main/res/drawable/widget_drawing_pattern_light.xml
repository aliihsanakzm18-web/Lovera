<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <!-- 1. Sanatsal Çizim Tuvali / Açık Ferah Kar Beyazı Eskiz Zemin -->
    <path
        android:pathData="M 0,0 L 200,0 L 200,200 L 0,200 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="100"
                android:centerY="100"
                android:gradientRadius="140"
                android:type="radial">
                <item android:color="#FFFFFF" android:offset="0.0" />
                <item android:color="#F8FAFC" android:offset="0.55" />
                <item android:color="#EEF2F6" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 2. Pastel Mor & Pembe Sanatçı Halesi -->
    <path
        android:pathData="M 0,0 L 140,0 L 0,140 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="20"
                android:centerY="20"
                android:gradientRadius="90"
                android:type="radial">
                <item android:color="#1A8B5CF6" android:offset="0.0" />
                <item android:color="#008B5CF6" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <path
        android:pathData="M 60,200 L 200,200 L 200,60 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="170"
                android:centerY="170"
                android:gradientRadius="90"
                android:type="radial">
                <item android:color="#16EC4899" android:offset="0.0" />
                <item android:color="#00EC4899" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 3. Eskiz / Çizim Izgarası (Köşe Çentikleri) -->
    <path
        android:strokeColor="#308B5CF6"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:pathData="M 12,20 L 12,12 L 20,12 M 188,20 L 188,12 L 180,12 M 12,180 L 12,188 L 20,188 M 188,180 L 188,188 L 180,188" />

    <!-- 4. Çizim Motifleri (Ressam Paleti, Fırça, Kalem, Çizgi & Karalama Sanatı) -->
