        android:fillColor="#158B5CF6"
        android:strokeColor="#3A7C3AED"
        android:strokeWidth="1"
        android:strokeLineCap="round"
        android:pathData="M 168,36 L 150,54 L 146,56 L 144,62 L 140,64 L 142,60 L 144,58 L 148,54 L 166,34 Z" />
