        android:pathData="M 115,45 Q 115,51 121,51 Q 115,51 115,57 Q 115,51 109,51 Q 115,51 115,45 Z" />

    <!-- Boya Damlaları -->
    <path
        android:fillColor="#308B5CF6"
        android:pathData="M 96,128 A 1.4,1.4 0 1,0 96,128.1 Z M 156,92 A 1.2,1.2 0 1,0 156,92.1 Z M 65,108 A 1,1 0 1,0 65,108.1 Z M 126,116 A 1.2,1.2 0 1,0 126,116.1 Z M 80,48 A 1.5,1.5 0 1,0 80,48.1 Z M 168,162 A 1.2,1.2 0 1,0 168,162.1 Z" />

</vector>
