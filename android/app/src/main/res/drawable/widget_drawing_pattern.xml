<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <!-- 1. Sanatsal Çizim Tuvali / Gece Taslak Zemin Degrade -->
    <path
        android:pathData="M 0,0 L 200,0 L 200,200 L 0,200 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="100"
                android:centerY="100"
                android:gradientRadius="140"
                android:type="radial">
                <item android:color="#221A3D" android:offset="0.0" />
                <item android:color="#18132C" android:offset="0.55" />
                <item android:color="#0F0C1B" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 2. Sanatçı Işık Halesi (Sol Üst Mor & Sağ Alt Pembe) -->
    <path
        android:pathData="M 0,0 L 140,0 L 0,140 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="20"
                android:centerY="20"
                android:gradientRadius="90"
                android:type="radial">
                <item android:color="#248B5CF6" android:offset="0.0" />
                <item android:color="#008B5CF6" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <path
        android:pathData="M 60,200 L 200,200 L 200,60 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="170"
                android:centerY="170"
                android:gradientRadius="90"
                android:type="radial">
                <item android:color="#1AEC4899" android:offset="0.0" />
                <item android:color="#00EC4899" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 3. Eskiz / Çizim Izgarası (Hafif Sanatsal Nokta & Kılavuz Dokusu) -->
    <!-- Köşe Eskiz Çerçeve Çentikleri (L Şeklinde Teknik Çizim İşaretleri) -->
    <path
        android:strokeColor="#24A78BFA"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:pathData="M 12,20 L 12,12 L 20,12 M 188,20 L 188,12 L 180,12 M 12,180 L 12,188 L 20,188 M 188,180 L 188,188 L 180,188" />

    <!-- 4. Çizim Motifleri (Ressam Paleti, Fırça, Kalem, Çizgi & Karalama Sanatı) -->
    <!-- Ressam Paleti 🎨 (Sol Üst / Orta) -->
    <!-- Palet Gövdesi -->
    <path
        android:fillColor="#10A78BFA"
        android:strokeColor="#2DA78BFA"
        android:strokeWidth="1"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M 44,52 C 54,46 68,52 68,64 C 68,76 60,82 50,82 C 40,82 32,74 32,62 C 32,54 38,48 44,52 Z" />
    <!-- Palet Başparmak Deliği -->
    <path
        android:fillColor="#18132C"
        android:strokeColor="#2DA78BFA"
        android:strokeWidth="0.8"
        android:pathData="M 40,68 A 3,3 0 1,0 40,68.1 Z" />
    <!-- Palet Renk Noktaları -->
    <path
        android:fillColor="#35EC4899"
        android:pathData="M 46,56 A 1.8,1.8 0 1,0 46,56.1 Z" />
    <path
        android:fillColor="#35F59E0B"
        android:pathData="M 56,58 A 1.8,1.8 0 1,0 56,58.1 Z" />
    <path
        android:fillColor="#3510B981"
        android:pathData="M 60,68 A 1.8,1.8 0 1,0 60,68.1 Z" />

    <!-- Ressam Fırçası 🖌️ (Sağ Üstten Çapraz İnen Fırça) -->
    <!-- Fırça Sapı ve Ucu -->
    <path
        android:fillColor="#12A78BFA"
        android:strokeColor="#30C4B5FD"
        android:strokeWidth="1"
        android:strokeLineCap="round"
        android:pathData="M 168,36 L 150,54 L 146,56 L 144,62 L 140,64 L 142,60 L 144,58 L 148,54 L 166,34 Z" />
    <!-- Fırçadan Damlayan Sanat Damlası -->
    <path
        android:fillColor="#25A78BFA"
        android:pathData="M 136,68 C 136,65 139,64 139,68 C 139,70 137.5,71 136,71 C 134.5,71 133,70 133,68 C 133,64 136,65 136,68 Z" />

    <!-- Kurşun Kalem ✏️ (Sağ Alt / Merkez) -->
    <path
        android:fillColor="#10EC4899"
        android:strokeColor="#2EEC4899"
        android:strokeWidth="0.9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M 160,130 L 144,146 L 138,154 L 138,150 L 146,142 L 162,126 Z M 138,154 L 142,148" />

    <!-- Akıcı Dalgalı Fırça Darbesi ~ (Alt Orta Eskiz Çizgisi) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#24A78BFA"
        android:strokeWidth="1.1"
        android:strokeLineCap="round"
        android:pathData="M 50,158 C 70,148 85,168 105,158 C 120,150 135,162 150,154" />

    <!-- Cetvel Çizgileri & Eskiz Karalama Çaprazları 📐 -->
    <path
        android:strokeColor="#1EA78BFA"
        android:strokeWidth="0.8"
        android:strokeLineCap="round"
        android:pathData="M 30,120 L 30,140 M 30,120 L 35,120 M 30,125 L 33,125 M 30,130 L 35,130 M 30,135 L 33,135 M 30,140 L 35,140" />

    <!-- Çizilmiş Romantik Kalp Eskizi (Merkez Sol) -->
    <path
        android:fillColor="#0DC4B5FD"
        android:strokeColor="#28C4B5FD"
        android:strokeWidth="1"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M 85,78 C 80,72 72,74 70,82 C 68,90 85,102 85,102 C 85,102 102,90 100,82 C 98,74 90,72 85,78 Z" />

    <!-- Işıltı & Parlama Yıldızı ✦ (Eskiz Detayı) -->
    <path
        android:fillColor="#20FFFFFF"
        android:strokeColor="#35FFFFFF"
        android:strokeWidth="0.8"
        android:pathData="M 115,45 Q 115,51 121,51 Q 115,51 115,57 Q 115,51 109,51 Q 115,51 115,45 Z" />

    <!-- Minik Sanatsal Boya Sıçramaları & Noktalar -->
    <path
        android:fillColor="#25A78BFA"
        android:pathData="M 96,128 A 1.4,1.4 0 1,0 96,128.1 Z M 156,92 A 1.2,1.2 0 1,0 156,92.1 Z M 65,108 A 1,1 0 1,0 65,108.1 Z M 126,116 A 1.2,1.2 0 1,0 126,116.1 Z M 80,48 A 1.5,1.5 0 1,0 80,48.1 Z M 168,162 A 1.2,1.2 0 1,0 168,162.1 Z" />

</vector>
