<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <!-- 1. Zemin Radyal Derin Degrade -->
    <path
        android:pathData="M 0,0 L 200,0 L 200,200 L 0,200 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="100"
                android:centerY="100"
                android:gradientRadius="140"
                android:type="radial">
                <item android:color="#241B42" android:offset="0.0" />
                <item android:color="#191430" android:offset="0.55" />
                <item android:color="#0F0C1B" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 2. Sol Üst Yumuşak Mor Aurora Işığı -->
    <path
        android:pathData="M 0,0 L 140,0 L 0,140 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="20"
                android:centerY="20"
                android:gradientRadius="90"
                android:type="radial">
                <item android:color="#268B5CF6" android:offset="0.0" />
                <item android:color="#008B5CF6" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 3. Sağ Alt Gül Pembesi Işıltısı -->
    <path
        android:pathData="M 60,200 L 200,200 L 200,60 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="170"
                android:centerY="170"
                android:gradientRadius="90"
                android:type="radial">
                <item android:color="#1CEC4899" android:offset="0.0" />
                <item android:color="#00EC4899" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 4. Romantik Doodle & Kozmik Vektör Süslemeleri (Hafif Şeffaf Watermark) -->
    <!-- Kalp 1 (Sol Üst) -->
    <path
        android:fillColor="#14A78BFA"
        android:strokeColor="#22C4B5FD"
        android:strokeWidth="1"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M 46,62 C 40,54 30,56 28,66 C 26,76 46,90 46,90 C 46,90 66,76 64,66 C 62,56 52,54 46,62 Z" />

    <!-- 4 Köşeli Parlak Yıldız ✦ (Sağ Üst) -->
    <path
        android:fillColor="#18FFFFFF"
        android:strokeColor="#2DF3F4F6"
        android:strokeWidth="0.8"
        android:pathData="M 152,48 Q 152,56 160,56 Q 152,56 152,64 Q 152,56 144,56 Q 152,56 152,48 Z" />

    <!-- Hilal Ay 🌙 (Sol Orta/Alt) -->
    <path
        android:fillColor="#14A78BFA"
        android:strokeColor="#22DDD6FE"
        android:strokeWidth="0.8"
        android:pathData="M 38,124 C 44,124 50,129 50,136 C 50,143 44,148 38,148 C 42,146 45,141 45,136 C 45,131 42,126 38,124 Z" />

    <!-- Mektup Zarfı ✉️ (Merkez Sağ) -->
    <path
        android:fillColor="#0AFFFFFF"
        android:strokeColor="#1FA78BFA"
        android:strokeWidth="0.9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M 142,106 L 168,106 L 168,124 L 142,124 Z M 142,106 L 155,116 L 168,106" />

    <!-- Sonsuzluk Sembolü ∞ (Sağ Alt) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#1FA78BFA"
        android:strokeWidth="0.9"
        android:strokeLineCap="round"
        android:pathData="M 132,156 C 127,151 120,151 115,156 C 110,161 117,166 122,161 C 127,156 134,151 139,156 C 144,161 137,166 132,161 Z" />

    <!-- Yörüngeli Halka 🪐 (Sol Merkez) -->
    <path
        android:fillColor="#10A78BFA"
        android:strokeColor="#1EA78BFA"
        android:strokeWidth="0.8"
        android:pathData="M 48,100 A 7,7 0 1,0 48,100.1 Z" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#24DDD6FE"
        android:strokeWidth="0.7"
        android:pathData="M 36,102 Q 48,96 60,102 Q 48,108 36,102 Z" />

    <!-- Minik Parıltı Noktaları & Yıldız Tozu -->
    <path
        android:fillColor="#24FFFFFF"
        android:pathData="M 98,46 A 1.2,1.2 0 1,0 98,46.1 Z M 106,146 A 1.2,1.2 0 1,0 106,146.1 Z M 86,112 A 1.5,1.5 0 1,0 86,112.1 Z M 122,82 A 1,1 0 1,0 122,82.1 Z M 166,142 A 1.2,1.2 0 1,0 166,142.1 Z M 32,86 A 1,1 0 1,0 32,86.1 Z" />

</vector>
